# Copy to .env.dev (or .env.<profile>) and fill in. NEVER commit the copy.
#   cp performance/shared/env/.env.example performance/shared/env/.env.dev

# API address your catalog paths are appended to. For your own API, end it with the prefix, e.g. https://dev.example.com/api/v1
BASE_URL=https://quickpizza.grafana.com

# Login. Leave LOGIN_PATH empty for a public API. Use a TEST account, never a personal or admin one.
LOGIN_PATH=
EMAIL=
PASSWORD=
TOKEN_FIELD=access_token

# Optional: where reports go (default ../reports, relative to performance/k6/scripts)
# REPORTS_DIR=../reports
